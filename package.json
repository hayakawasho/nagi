{
  "name": "nagi",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @usenagi/core",
    "watch": "npm run watch -w @usenagi/core",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint ./packages/core/lib ./packages/addons/scheduler ./packages/addons/cue ./packages/addons/debug ./packages/addons/signals",
    "format": "biome format --write ./packages/core/lib ./packages/addons/scheduler ./packages/addons/cue ./packages/addons/debug ./packages/addons/signals",
    "fix:biome": "biome check --write ./packages/core/lib ./packages/addons/scheduler ./packages/addons/cue ./packages/addons/debug ./packages/addons/signals",
    "fix": "npm run fix:biome"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "happy-dom": "^20.9.0",
    "oxlint": "^1.66.0",
    "typescript": "^7.0.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "type": "module"
}
