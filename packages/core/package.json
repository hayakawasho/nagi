{
  "name": "@usenagi/core",
  "version": "0.7.0",
  "description": "Lightweight lifecycle hooks and reactivity for existing HTML.",
  "main": "./dist/main.umd.js",
  "module": "./dist/main.es.js",
  "exports": {
    ".": {
      "types": "./types/main.d.ts",
      "import": "./dist/main.es.js",
      "require": "./dist/main.umd.js"
    },
    "./addons/scheduler": {
      "types": "./types/addons/scheduler/index.d.ts",
      "import": "./dist/addons/scheduler.es.js",
      "require": "./dist/addons/scheduler.cjs.js"
    },
    "./addons/cue": {
      "types": "./types/addons/cue/index.d.ts",
      "import": "./dist/addons/cue.es.js",
      "require": "./dist/addons/cue.cjs.js"
    },
    "./addons/debug": {
      "types": "./types/addons/debug/index.d.ts",
      "import": "./dist/addons/debug.es.js",
      "require": "./dist/addons/debug.cjs.js"
    },
    "./addons/signals": {
      "types": "./types/addons/signals/index.d.ts",
      "import": "./dist/addons/signals.es.js",
      "require": "./dist/addons/signals.cjs.js"
    }
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "author": "hayakawasho",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hayakawasho/nagi.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/hayakawasho/nagi/issues"
  },
  "homepage": "https://github.com/hayakawasho/nagi/blob/main/packages/core/README.md",
  "keywords": [
    "dom",
    "component",
    "reactivity",
    "composition-api",
    "gsap",
    "animation",
    "vanilla",
    "progressive-enhancement"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "NODE_ENV=production tsc && tsc -p ../addons/tsconfig.json && vite build && vite build --config vite.addons.config.ts",
    "watch": "vite build -w"
  },
  "type": "module",
  "sideEffects": false,
  "dependencies": {
    "@preact/signals-core": "^1.14.4"
  }
}
